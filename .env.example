# BurbleBot — Environment Variable Template
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit your .env file — it is already listed in .gitignore.
# This .env.example file is safe to commit (no real secrets here).

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# The URL BurbleBot will navigate to on each capture cycle.
TARGET_URL=
JUMPER_MANIFEST_BODY=
JUMPER_MANIFEST_LOAD=

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Seconds to wait between capture cycles.
# Default: 60
SLEEP_INTERVAL=60

# Absolute path where the screenshot will be saved.
# Default: /app/output.png
OUTPUT_DESTINATION=/app/output.png
